PORT=4000
NODE_ENV=production

# ==============================================================================
# BANCO DE DADOS CENTRAL POSTGRESQL ONLINE (RECOMENDADO PARA PRODUÇÃO 24/7)
# Exemplos: Neon, Supabase, Railway Postgres, Render Postgres ou Aiven
# ==============================================================================
DATABASE_URL=postgresql://usuario:senha@host-online.neon.tech/regz_db?sslmode=require
DB_SSL=true
DB_POOL_MAX=10

# ==============================================================================
# FALLBACK POR CAMPOS INDIVIDUAIS (USADO SE DATABASE_URL NÃO FOR DEFINIDA)
# ==============================================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=regz_user
# DB_PASSWORD=regz_password
# DB_NAME=regz_db

# ==============================================================================
# SEGURANÇA E URL PÚBLICA EM PRODUÇÃO
# ==============================================================================
JWT_SECRET=substitua_por_uma_chave_secreta_forte_de_64_caracteres
APP_URL=https://seu-app-regz.up.railway.app
